<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="stars_beyond.GameplayPageMainUI"
             Background="Black">


    <Grid RowDefinitions="Auto,Auto,Auto,Auto" Padding="10" RowSpacing="10" VerticalOptions="End">
        <VerticalStackLayout>
            <Frame 
                Grid.Row="0"
                HeightRequest="350"
                BackgroundColor="Black"
                HasShadow="False"
                Padding="0"
                HorizontalOptions="Center"
                Margin="0,0,0,-2">
                <Grid>
                    <Label
                        x:Name="DamageLabel"
                        Text="0"
                        TextColor="Red"
                        FontSize="36"
                        FontFamily="Determination"
                        Opacity="0"
                        IsVisible="False"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        ZIndex="10"/>
                    <Image 
                        x:Name="CharacterImage"
                        Source="concept_1.png"
                        Aspect="AspectFit"/>
                </Grid>
            </Frame>
            <Border 
                x:Name="DialogBox"
                Stroke="White"
                StrokeThickness="4"
                BackgroundColor="Black"
                Padding="15"
                HeightRequest="180"
                HorizontalOptions="Fill">

                <Grid>
                    <Label
                        x:Name="DialogLabel"
                        Text="* Placeholder Text"
                        TextColor="White"
                        IsVisible="True"
                        FontFamily="Determination"
                        FontSize="30"/>
                    <Frame
                        x:Name="BattleFrame"
                        IsVisible="False"
                        BorderColor="White"
                        BackgroundColor="Black"
                        Padding="0"
                        HasShadow="False"
                        HeightRequest="180"
                        WidthRequest="300"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        ZIndex="5"
                        CornerRadius="0">
                        <AbsoluteLayout 
                            x:Name="BattleField"
                            WidthRequest="300"
                            HeightRequest="180">
                            <BoxView
                                x:Name="Player"
                                WidthRequest="16"
                                HeightRequest="16"
                                Color="Red"/>
                        </AbsoluteLayout>
                    </Frame>
                    <Grid 
                        x:Name="AttackMinigame"
                        IsVisible="False">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttackTap"/>
                        </Grid.GestureRecognizers>
                        <Image 
                            x:Name="AttackBar"
                            Source="attack_bar.png"
                            Aspect="Fill"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            HeightRequest="100"/>   
                        <BoxView 
                            x:Name="AttackSlider"
                            Color="White"
                            WidthRequest="8"
                            HeightRequest="125"
                            HorizontalOptions="Start"/>
                    </Grid>
                    <Grid 
                        x:Name="ActMenuGrid"
                        IsVisible="False"
                        Grid.Row="3"
                        ColumnDefinitions="*,*"
                        RowDefinitions="*,*"
                        RowSpacing="10"
                        ColumnSpacing="10">
                        <Button 
                            Text="* Check" 
                            Clicked="ActOptionClicked" 
                            CommandParameter="0"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                        <Button 
                            Grid.Column="1" 
                            Text="* Option 1" 
                            Clicked="ActOptionClicked" 
                            CommandParameter="1"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>

                        <Button 
                            Grid.Row="1" 
                            Text="* Option 2" 
                            Clicked="ActOptionClicked" 
                            CommandParameter="2"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                        <Button 
                            Grid.Row="1" 
                            Grid.Column="1" 
                            Text="* Option 3" 
                            Clicked="ActOptionClicked" 
                            CommandParameter="3"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                    </Grid>
                    <Grid 
                        x:Name="MercyMenuGrid"
                        IsVisible="False"
                        Grid.Row="3"
                        ColumnDefinitions="*,*"
                        RowDefinitions="*,*"
                        RowSpacing="10"
                        ColumnSpacing="10">
                        <Button 
                            Text="* Spare" 
                            Clicked="MercyOptionClicked" 
                            CommandParameter="0"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                        <Button 
                            Grid.Column="1" 
                            Text="* Flee" 
                            Clicked="MercyOptionClicked" 
                            CommandParameter="1"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                    </Grid>
                    <Grid 
                        x:Name="ItemMenuGrid"
                        IsVisible="False"
                        Grid.Row="3"
                        ColumnDefinitions="*,*"
                        RowDefinitions="*,*"
                        RowSpacing="10"
                        ColumnSpacing="10">
                        <Button 
                            x:Name="ItemBtn0" 
                            Clicked="ItemOptionClicked" 
                            CommandParameter="0"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                        <Button 
                            x:Name="ItemBtn1" 
                            Grid.Column="1" 
                            Clicked="ItemOptionClicked" 
                            CommandParameter="1"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                        <Button 
                            x:Name="ItemBtn2" 
                            Grid.Row="1" 
                            Clicked="ItemOptionClicked" 
                            CommandParameter="2"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>
                        <Button 
                            x:Name="ItemBtn3" 
                            Grid.Row="1" Grid.Column="1" 
                            Clicked="ItemOptionClicked" 
                            CommandParameter="3"
                            Background="Black"
                            FontSize="30"
                            FontFamily="Determination"
                            TextColor="White"/>

                    </Grid>
                </Grid>
            </Border>
        </VerticalStackLayout>
        <Grid 
            Grid.Row="2" 
            ColumnDefinitions="*,Auto" 
            VerticalOptions="Center" 
            HeightRequest="35">
            <Label 
                x:Name="NameLabel"
                Text="KITH  LV1"
                TextColor="White"
                FontFamily="Determination"
                FontSize="25"
                VerticalOptions="Center"/>

            <Grid
                HorizontalOptions="End" 
                VerticalOptions="Center">
                <Label
                    Text="HP"
                    TextColor="White"
                    FontSize="25"
                    FontFamily="Determination"
                    Margin="40,0,0,0"/>
                <BoxView 
                    Color="Gray" 
                    WidthRequest="45" 
                    HeightRequest="13"
                    HorizontalOptions="Start"
                    Margin="80,0,0,0"/>
                <BoxView 
                    x:Name="HpBar" 
                    Color="Yellow" 
                    WidthRequest="45" 
                    HeightRequest="13"
                    HorizontalOptions="Start"
                    Margin="80,0,0,0"/>
                <Label 
                    x:Name="HpLabel"
                    Text="20/20"
                    TextColor="White"
                    FontSize="25"
                    FontFamily="Determination"
                    Margin="140,0,0,0"/>
            </Grid>
        </Grid>
        <Grid Grid.Row="3" ColumnDefinitions="*,*" RowDefinitions="*,*" RowSpacing="10" ColumnSpacing="10" x:Name="ActionButtons">
            <Button 
                Grid.Row="0" 
                Grid.Column="0"
                HeightRequest="60"
                BackgroundColor="Black"
                BorderColor="#EA260C"
                BorderWidth="4"
                CornerRadius="0"
                ImageSource="fight_icon.png"
                Padding="4"
                Clicked="FightClicked"/>
            <Button 
                Grid.Row="0" 
                Grid.Column="1"
                HeightRequest="60"
                BackgroundColor="Black"
                BorderColor="#EA260C"
                BorderWidth="4"
                CornerRadius="0"
                ImageSource="act_icon.png"
                Padding="4"
                Clicked="ActClicked">
            </Button>
            <Button 
                Grid.Row="1" 
                Grid.Column="0"
                HeightRequest="60"
                BackgroundColor="Black"
                BorderColor="#EA260C"
                BorderWidth="4"
                CornerRadius="0"
                ImageSource="item_icon.png"
                Padding="4"
                Clicked="ItemClicked"/>
            <Button 
                Grid.Row="1" 
                Grid.Column="1"
                HeightRequest="60"
                BackgroundColor="Black"
                BorderColor="#EA260C"
                BorderWidth="4"
                CornerRadius="0"
                ImageSource="mercy_icon.png"
                Padding="4"
                Clicked="MercyClicked"/>
        </Grid>
        <Grid
            Grid.Row="3"
            x:Name="MovementControls"
            IsVisible="False"
            ColumnDefinitions="*,*,*"
            RowDefinitions="Auto,Auto,Auto"
            HorizontalOptions="Center">
            <Grid x:Name="DPad"
                WidthRequest="200"
                HeightRequest="200"
                HorizontalOptions="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Source="arrows.png"
                    Aspect="AspectFit"
                    Grid.RowSpan="3"
                    Grid.ColumnSpan="3"
                    InputTransparent="True"/>
                <ImageButton x:Name="UpButton" Grid.Row="0"
                     Grid.Column="1"
                     BackgroundColor="Transparent"
                     Pressed="UpPressed"
                     Released="StopMove"
                     IsEnabled="True"/>
                <ImageButton x:Name="DownButton" Grid.Row="2"
                     Grid.Column="1"
                     BackgroundColor="Transparent"
                     Pressed="DownPressed"
                     Released="StopMove"
                     IsEnabled="True"/>
                <ImageButton x:Name="LeftButton" Grid.Row="1"
                     Grid.Column="0"
                     BackgroundColor="Transparent"
                     Pressed="LeftPressed"
                     Released="StopMove"
                     IsEnabled="True"/>
                <ImageButton x:Name="RightButton" Grid.Row="1"
                     Grid.Column="2"
                     BackgroundColor="Transparent"
                     Pressed="RightPressed"
                     Released="StopMove"
                     IsEnabled="True"/>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>